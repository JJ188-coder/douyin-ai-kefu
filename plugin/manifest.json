{
  "manifest_version": 3,
  "name": "抖音来客 AI 人工接管助手",
  "version": "0.3.9",
  "description": "买家会话转人工(allocated_service)后由 AI 接管自动回复；人工接管自动静音防抢答；答不了的问题通过角标/桌面通知/飞书通知店主",
  "permissions": [
    "storage",
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "https://*.douyin.com/*",
    "https://open.feishu.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://life.douyin.com/cs/web*"
      ],
      "js": [
        "core/store-bridge.js",
        "core/llm-engine.js",
        "core/knowledge.js",
        "core/agent.js",
        "core/host.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://life.douyin.com/cs/web*"
      ],
      "js": [
        "host-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon128.png"
  }
}